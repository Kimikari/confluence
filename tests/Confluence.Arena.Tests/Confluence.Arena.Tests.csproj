<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>Confluence.Arena.Tests</RootNamespace>
    <!-- The fairness batches generate arenas on every core; server GC keeps the allocation-heavy navigation builds
         from serializing on collections. -->
    <ServerGarbageCollector>true</ServerGarbageCollector>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Confluence.Core\Confluence.Core.csproj" />
    <ProjectReference Include="..\..\src\Confluence.Arena\Confluence.Arena.csproj" />
    <!-- Round diameter equivalence only: the match owns the diameter and ArenaSchedule must repeat it. -->
    <ProjectReference Include="..\..\src\Confluence.Match\Confluence.Match.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>

/* Confluence client UI. Elements are built in code (Assets/Scripts/UI); this sheet only styles class names. */

.cf-root {
    flex-grow: 1;
    color: rgb(232, 228, 216);
    font-size: 18px;
}

.cf-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    padding: 48px 64px;
}

.cf-screen--menu {
    background-color: rgba(10, 12, 18, 0.92);
    flex-direction: row;
}

.cf-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(4, 5, 8, 0.78);
    align-items: center;
    justify-content: center;
}

.cf-title {
    font-size: 72px;
    -unity-font-style: bold;
    letter-spacing: 12px;
    color: rgb(244, 214, 140);
    margin-bottom: 4px;
}

.cf-subtitle {
    font-size: 22px;
    color: rgb(170, 176, 190);
    margin-bottom: 36px;
}

.cf-heading {
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(244, 214, 140);
    margin-bottom: 12px;
}

.cf-text {
    white-space: normal;
    margin-bottom: 8px;
}

.cf-muted {
    color: rgb(150, 156, 170);
    font-size: 15px;
    white-space: normal;
}

.cf-column {
    flex-direction: column;
}

.cf-row {
    flex-direction: row;
    align-items: center;
}

.cf-grow {
    flex-grow: 1;
}

.cf-nav {
    width: 360px;
    flex-shrink: 0;
}

.cf-panel {
    background-color: rgba(26, 30, 42, 0.94);
    border-color: rgb(78, 86, 110);
    border-width: 1px;
    border-radius: 6px;
    padding: 20px 24px;
    margin-bottom: 16px;
}

.cf-panel--dialog {
    width: 820px;
    max-height: 90%;
}

.cf-button {
    height: 52px;
    margin: 0 0 10px 0;
    font-size: 22px;
    -unity-text-align: middle-left;
    padding-left: 20px;
    background-color: rgb(40, 46, 64);
    border-color: rgb(92, 102, 132);
    border-width: 1px;
    border-radius: 4px;
    color: rgb(232, 228, 216);
}

.cf-button:hover {
    background-color: rgb(60, 70, 98);
    border-color: rgb(244, 214, 140);
}

.cf-button:active {
    background-color: rgb(84, 96, 130);
}

.cf-button:disabled {
    color: rgb(110, 114, 126);
    background-color: rgb(30, 33, 44);
}

.cf-button--primary {
    background-color: rgb(120, 86, 34);
    border-color: rgb(244, 214, 140);
}

.cf-button--primary:hover {
    background-color: rgb(150, 108, 44);
}

.cf-button--small {
    height: 34px;
    font-size: 16px;
    padding-left: 12px;
    padding-right: 12px;
    margin-right: 8px;
    -unity-text-align: middle-center;
}

.cf-button--selected {
    border-color: rgb(244, 214, 140);
    background-color: rgb(70, 64, 46);
}

.cf-field {
    margin-bottom: 10px;
    font-size: 18px;
}

.cf-field > Label {
    min-width: 220px;
    color: rgb(200, 204, 214);
}

/* Dark text inputs (text fields, integer fields, slider value boxes) and toggles; the default runtime theme's
   light input boxes are unreadable with the light text color inherited from .cf-root. */
.cf-root .unity-base-text-field__input {
    background-color: rgb(16, 19, 28);
    border-color: rgb(92, 102, 132);
    color: rgb(232, 228, 216);
    --unity-cursor-color: rgb(244, 214, 140);
    --unity-selection-color: rgba(244, 214, 140, 0.35);
}

.cf-root .unity-base-text-field__input:hover {
    border-color: rgb(130, 140, 170);
}

.cf-root .unity-base-field:focus .unity-base-text-field__input {
    border-color: rgb(244, 214, 140);
}

.cf-root .unity-toggle__checkmark {
    background-color: rgb(16, 19, 28);
    border-color: rgb(92, 102, 132);
    -unity-background-image-tint-color: rgb(244, 214, 140);
}

.cf-footer {
    position: absolute;
    left: 64px;
    right: 64px;
    bottom: 20px;
}

.cf-codex-list {
    width: 420px;
    flex-shrink: 0;
    margin-right: 16px;
    background-color: rgba(18, 21, 30, 0.9);
}

.cf-codex-item {
    font-size: 16px;
    padding-left: 8px;
    -unity-text-align: middle-left;
}

.cf-codex-detail {
    flex-grow: 1;
    background-color: rgba(18, 21, 30, 0.9);
    padding: 12px 16px;
}

.cf-codex-key {
    color: rgb(244, 214, 140);
    font-size: 15px;
    margin-top: 8px;
}

.cf-hud {
    position: absolute;
    left: 16px;
    top: 16px;
    width: 560px;
    background-color: rgba(10, 12, 18, 0.72);
    border-radius: 6px;
    padding: 12px 16px;
    font-size: 15px;
}

.cf-hud--legend {
    left: auto;
    right: 16px;
    width: 380px;
}

.cf-hud-title {
    font-size: 19px;
    -unity-font-style: bold;
    color: rgb(244, 214, 140);
    white-space: normal;
}

.cf-legend-row {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
}

.cf-legend-swatch {
    width: 36px;
    height: 36px;
    margin-right: 10px;
    border-width: 1px;
    border-color: rgb(20, 20, 20);
    flex-shrink: 0;
}

.cf-crosshair {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 6px;
    height: 6px;
    margin-left: -3px;
    margin-top: -3px;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.85);
}

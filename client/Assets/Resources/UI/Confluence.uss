/* Confluence client UI. Elements are built in code (Assets/Scripts/UI); this sheet only styles class names. */

.cf-root {
    flex-grow: 1;
    color: rgb(232, 228, 216);
    font-size: 18px;
}

.cf-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    padding: 48px 64px;
}

.cf-screen--menu {
    background-color: rgba(10, 12, 18, 0.92);
    flex-direction: row;
}

.cf-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(4, 5, 8, 0.78);
    align-items: center;
    justify-content: center;
}

.cf-title {
    font-size: 72px;
    -unity-font-style: bold;
    letter-spacing: 12px;
    color: rgb(244, 214, 140);
    margin-bottom: 4px;
}

.cf-subtitle {
    font-size: 22px;
    color: rgb(170, 176, 190);
    margin-bottom: 36px;
}

.cf-heading {
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(244, 214, 140);
    margin-bottom: 12px;
}

.cf-text {
    white-space: normal;
    margin-bottom: 8px;
}

.cf-muted {
    color: rgb(150, 156, 170);
    font-size: 15px;
    white-space: normal;
}

.cf-column {
    flex-direction: column;
}

.cf-row {
    flex-direction: row;
    align-items: center;
}

.cf-grow {
    flex-grow: 1;
}

.cf-nav {
    width: 360px;
    flex-shrink: 0;
}

.cf-panel {
    background-color: rgba(26, 30, 42, 0.94);
    border-color: rgb(78, 86, 110);
    border-width: 1px;
    border-radius: 6px;
    padding: 20px 24px;
    margin-bottom: 16px;
}

.cf-panel--dialog {
    width: 820px;
    max-height: 90%;
}

.cf-button {
    height: 52px;
    margin: 0 0 10px 0;
    font-size: 22px;
    -unity-text-align: middle-left;
    padding-left: 20px;
    background-color: rgb(40, 46, 64);
    border-color: rgb(92, 102, 132);
    border-width: 1px;
    border-radius: 4px;
    color: rgb(232, 228, 216);
}

.cf-button:hover {
    background-color: rgb(60, 70, 98);
    border-color: rgb(244, 214, 140);
}

.cf-button:active {
    background-color: rgb(84, 96, 130);
}

.cf-button:disabled {
    color: rgb(110, 114, 126);
    background-color: rgb(30, 33, 44);
}

.cf-button--primary {
    background-color: rgb(120, 86, 34);
    border-color: rgb(244, 214, 140);
}

.cf-button--primary:hover {
    background-color: rgb(150, 108, 44);
}

.cf-button--small {
    height: 34px;
    font-size: 16px;
    padding-left: 12px;
    padding-right: 12px;
    margin-right: 8px;
    -unity-text-align: middle-center;
}

.cf-button--selected {
    border-color: rgb(244, 214, 140);
    background-color: rgb(70, 64, 46);
}

.cf-field {
    margin-bottom: 10px;
    font-size: 18px;
}

.cf-field > Label {
    min-width: 220px;
    color: rgb(200, 204, 214);
}

/* Dark text inputs (text fields, integer fields, slider value boxes) and toggles; the default runtime theme's
   light input boxes are unreadable with the light text color inherited from .cf-root. */
.cf-root .unity-base-text-field__input {
    background-color: rgb(16, 19, 28);
    border-color: rgb(92, 102, 132);
    color: rgb(232, 228, 216);
    --unity-cursor-color: rgb(244, 214, 140);
    --unity-selection-color: rgba(244, 214, 140, 0.35);
}

.cf-root .unity-base-text-field__input:hover {
    border-color: rgb(130, 140, 170);
}

.cf-root .unity-base-field:focus .unity-base-text-field__input {
    border-color: rgb(244, 214, 140);
}

.cf-root .unity-toggle__checkmark {
    background-color: rgb(16, 19, 28);
    border-color: rgb(92, 102, 132);
    -unity-background-image-tint-color: rgb(244, 214, 140);
}

.cf-footer {
    position: absolute;
    left: 64px;
    right: 64px;
    bottom: 20px;
}

.cf-codex-list {
    width: 420px;
    flex-shrink: 0;
    margin-right: 16px;
    background-color: rgba(18, 21, 30, 0.9);
}

.cf-codex-item {
    font-size: 16px;
    padding-left: 8px;
    -unity-text-align: middle-left;
}

.cf-codex-detail {
    flex-grow: 1;
    background-color: rgba(18, 21, 30, 0.9);
    padding: 12px 16px;
}

.cf-codex-key {
    color: rgb(244, 214, 140);
    font-size: 15px;
    margin-top: 8px;
}

.cf-hud {
    position: absolute;
    left: 16px;
    top: 16px;
    width: 560px;
    background-color: rgba(10, 12, 18, 0.72);
    border-radius: 6px;
    padding: 12px 16px;
    font-size: 15px;
}

.cf-hud--legend {
    left: auto;
    right: 16px;
    width: 380px;
}

.cf-hud-title {
    font-size: 19px;
    -unity-font-style: bold;
    color: rgb(244, 214, 140);
    white-space: normal;
}

.cf-legend-row {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
}

.cf-legend-swatch {
    width: 36px;
    height: 36px;
    margin-right: 10px;
    border-width: 1px;
    border-color: rgb(20, 20, 20);
    flex-shrink: 0;
}

.cf-crosshair {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 6px;
    height: 6px;
    margin-left: -3px;
    margin-top: -3px;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.85);
}

/* ---- Arena preview generator panel ---- */

.cf-hud--generator {
    max-height: 700px;
    width: 600px;
}

.cf-hud-column {
    position: absolute;
    left: 16px;
    top: 16px;
    bottom: 16px;
    width: 600px;
}

.cf-hud-column > .cf-hud {
    position: relative;
    left: 0;
    top: 0;
    width: 600px;
    margin-bottom: 8px;
    flex-shrink: 1;
}

.cf-hud--generator .cf-field > Label {
    min-width: 150px;
}

.cf-metrics {
    max-height: 360px;
    margin-top: 6px;
}

.cf-metric-row {
    flex-direction: row;
    justify-content: space-between;
    border-bottom-width: 1px;
    border-color: rgba(92, 102, 132, 0.35);
    padding: 2px 0;
}

.cf-metric-label {
    color: rgb(170, 176, 190);
    font-size: 14px;
    flex-shrink: 1;
    white-space: normal;
}

.cf-metric-value {
    color: rgb(232, 228, 216);
    font-size: 14px;
    -unity-font-style: bold;
    margin-left: 12px;
    flex-shrink: 0;
}

.cf-warning {
    color: rgb(255, 170, 90);
    -unity-font-style: bold;
}

.cf-root .unity-base-popup-field__input {
    background-color: rgb(16, 19, 28);
    border-color: rgb(92, 102, 132);
    color: rgb(232, 228, 216);
}

/* ---- Laboratory and match screens (shop, draft, build panel, reveal, results) ---- */

.cf-lab-label {
    color: rgb(255, 196, 92);
    font-size: 15px;
    -unity-font-style: bold;
    background-color: rgba(70, 44, 10, 0.85);
    border-color: rgb(255, 196, 92);
    border-width: 1px;
    border-radius: 3px;
    padding: 3px 10px;
    margin-bottom: 10px;
    align-self: flex-start;
    white-space: normal;
}

.cf-screen--match {
    background-color: rgba(10, 12, 18, 0.96);
    flex-direction: column;
    padding: 28px 40px;
}

.cf-screen--side {
    flex-direction: row;
    padding: 0;
}

.cf-side-panel {
    width: 34%;
    height: 100%;
    margin: 0;
    border-radius: 0;
    background-color: rgba(14, 17, 25, 0.95);
    padding: 24px 28px;
}

.cf-match-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.cf-match-header .cf-heading {
    flex-grow: 1;
    margin-bottom: 0;
}

.cf-crowns {
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(255, 214, 120);
    margin-right: 32px;
}

.cf-phase-timer {
    font-size: 24px;
    color: rgb(232, 228, 216);
}

.cf-match-body {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
}

.cf-match-main {
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 20px;
    min-width: 0;
}

.cf-match-side {
    width: 640px;
    flex-shrink: 0;
    background-color: rgba(20, 24, 34, 0.95);
    border-color: rgb(70, 78, 100);
    border-width: 1px;
    border-radius: 6px;
    padding: 12px 14px;
}

.cf-match-message {
    font-size: 18px;
    color: rgb(170, 220, 170);
    margin: 10px 0;
    white-space: normal;
}

.cf-match-message--error {
    color: rgb(255, 150, 120);
}

.cf-card-row {
    flex-direction: row;
    align-items: stretch;
    height: 560px;
}

.cf-card-row--draft {
    height: auto;
    flex-grow: 1;
    min-height: 0;
}

.cf-match-body > .cf-match-side {
    flex-grow: 0;
}

.cf-match-body > .cf-match-side--narrow {
    width: 470px;
}

.cf-card--augment {
    margin-right: 10px;
    padding: 12px 12px;
}

.cf-card--augment .cf-card-name {
    font-size: 20px;
}

.cf-card--augment .cf-card-text {
    font-size: 15px;
}

.cf-card--augment .cf-card-small,
.cf-card--augment .cf-card-drawback {
    font-size: 13px;
}

.cf-card {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 14px;
    padding: 14px 16px;
    background-color: rgb(28, 33, 46);
    border-color: rgb(92, 102, 132);
    border-width: 2px;
    border-radius: 8px;
}

.cf-card--purchased {
    opacity: 0.55;
    border-color: rgb(80, 150, 90);
}

.cf-card--muted {
    opacity: 0.7;
    border-color: rgb(80, 80, 90);
}

.cf-card--silver {
    border-color: rgb(196, 204, 214);
}

.cf-card--gold {
    border-color: rgb(236, 190, 70);
}

.cf-card--prismatic {
    border-color: rgb(196, 120, 255);
}

.cf-card-index {
    font-size: 13px;
    color: rgb(130, 136, 150);
}

.cf-card-rarity {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(244, 214, 140);
    margin-bottom: 4px;
    white-space: normal;
}

.cf-card-name {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(244, 236, 214);
    white-space: normal;
    margin-bottom: 4px;
}

.cf-card-price {
    font-size: 17px;
    color: rgb(255, 214, 120);
    margin-bottom: 4px;
    white-space: normal;
}

.cf-card-meta {
    font-size: 15px;
    color: rgb(150, 190, 230);
    margin-bottom: 8px;
    white-space: normal;
}

.cf-card-text {
    font-size: 16px;
    white-space: normal;
    margin-bottom: 8px;
}

.cf-card-small {
    font-size: 14px;
    color: rgb(170, 176, 190);
    white-space: normal;
    margin-bottom: 6px;
}

.cf-card-drawback {
    font-size: 14px;
    color: rgb(255, 170, 130);
    white-space: normal;
    margin-bottom: 6px;
}

.cf-card-notice {
    font-size: 14px;
    color: rgb(255, 196, 92);
    -unity-font-style: bold;
    white-space: normal;
    margin-bottom: 6px;
}

.cf-card-reroll {
    font-size: 14px;
    color: rgb(120, 220, 160);
    margin-bottom: 8px;
}

.cf-card-reroll--used {
    color: rgb(140, 140, 150);
}

.cf-button--tiny {
    height: 26px;
    font-size: 13px;
    padding-left: 8px;
    padding-right: 8px;
    margin: 0 0 0 6px;
    -unity-text-align: middle-center;
}

.cf-button--wide {
    width: 360px;
    margin-right: 20px;
}

.cf-build {
    flex-grow: 1;
    min-height: 0;
}

.cf-build-scroll {
    flex-grow: 1;
}

.cf-build-title {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(244, 214, 140);
    white-space: normal;
}

.cf-build-section {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(244, 214, 140);
    margin-top: 10px;
    margin-bottom: 2px;
    border-bottom-width: 1px;
    border-color: rgba(244, 214, 140, 0.3);
}

.cf-build-row {
    flex-direction: row;
    align-items: center;
    min-height: 24px;
    flex-wrap: wrap;
}

.cf-build-wrap {
    flex-direction: row;
    flex-wrap: wrap;
}

.cf-build-key {
    width: 150px;
    font-size: 14px;
    color: rgb(170, 176, 190);
}

.cf-build-value {
    font-size: 14px;
    color: rgb(232, 228, 216);
    white-space: normal;
    flex-shrink: 1;
}

.cf-build-dim {
    font-size: 14px;
    color: rgb(130, 136, 150);
    white-space: normal;
    flex-shrink: 1;
}

.cf-build-tag {
    font-size: 12px;
    color: rgb(120, 220, 160);
    margin-left: 8px;
}

.cf-build-dormant {
    font-size: 13px;
    color: rgb(255, 170, 90);
    -unity-font-style: bold;
    margin-left: 8px;
    white-space: normal;
}

.cf-build-small {
    font-size: 12px;
    color: rgb(150, 156, 170);
    white-space: normal;
}

.cf-build-slotnum {
    width: 22px;
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(244, 214, 140);
}

.cf-build-spell {
    flex-grow: 1;
    flex-shrink: 1;
}

.cf-draft-dialog {
    background-color: rgba(40, 30, 14, 0.96);
    border-color: rgb(255, 196, 92);
    border-width: 2px;
    border-radius: 6px;
    padding: 12px 16px;
    margin-top: 12px;
}

.cf-results-outcome {
    font-size: 54px;
    -unity-font-style: bold;
    color: rgb(244, 214, 140);
}

.cf-panel--inspect {
    width: 900px;
    height: 88%;
}

/* ---- In-combat HUD (spec L347-L349) ---- */

.cf-duel-hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.cf-duel-top {
    position: absolute;
    top: 14px;
    left: 30%;
    right: 30%;
    align-items: center;
}

.cf-duel-timer {
    font-size: 44px;
    -unity-font-style: bold;
    color: rgb(244, 236, 214);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.cf-duel-phase {
    font-size: 16px;
    background-color: rgba(10, 12, 18, 0.65);
    padding: 1px 10px;
    border-radius: 3px;
    color: rgb(200, 204, 214);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.cf-duel-boundary {
    font-size: 17px;
    color: rgb(214, 218, 228);
    margin-top: 4px;
    background-color: rgba(10, 12, 18, 0.65);
    padding: 2px 10px;
    border-radius: 3px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.cf-duel-boundary--contracting {
    color: rgb(255, 170, 190);
}

.cf-duel-boundary--outside {
    color: rgb(255, 255, 255);
    background-color: rgba(200, 30, 60, 0.85);
    padding: 4px 12px;
    border-radius: 4px;
    -unity-font-style: bold;
    font-size: 22px;
}

.cf-duel-judgement {
    margin-top: 6px;
    font-size: 18px;
    -unity-font-style: bold;
    padding: 3px 12px;
    border-radius: 4px;
    background-color: rgba(60, 64, 80, 0.85);
    color: rgb(232, 228, 216);
}

.cf-duel-judgement--ahead {
    background-color: rgba(40, 120, 70, 0.9);
}

.cf-duel-judgement--behind {
    background-color: rgba(150, 50, 40, 0.9);
}

.cf-duel-corner {
    position: absolute;
    left: 18px;
    top: 14px;
    width: 640px;
}

.cf-duel-notice {
    font-size: 14px;
    color: rgb(200, 204, 214);
    background-color: rgba(10, 12, 18, 0.7);
    padding: 3px 8px;
    border-radius: 3px;
    white-space: normal;
    margin-bottom: 8px;
}

.cf-duel-help {
    position: absolute;
    right: 18px;
    top: 14px;
    width: 420px;
    background-color: rgba(10, 12, 18, 0.6);
    padding: 6px 10px;
    border-radius: 4px;
}

.cf-duel-help-text {
    font-size: 13px;
    color: rgb(190, 194, 206);
    white-space: normal;
}

.cf-status-row {
    flex-direction: row;
    flex-wrap: wrap;
}

.cf-status-icon {
    flex-direction: row;
    align-items: center;
    background-color: rgba(10, 12, 18, 0.78);
    border-width: 2px;
    border-color: rgb(120, 126, 140);
    border-radius: 4px;
    padding: 2px 8px 2px 4px;
    margin: 0 6px 6px 0;
}

.cf-status-glyph {
    font-size: 14px;
    -unity-font-style: bold;
    background-color: rgb(60, 66, 84);
    color: rgb(255, 255, 255);
    padding: 1px 5px;
    border-radius: 3px;
    margin-right: 6px;
}

.cf-status-text {
    font-size: 14px;
    color: rgb(232, 228, 216);
}

.cf-status-icon--controlimmunity {
    border-color: rgb(250, 250, 250);
}

.cf-status-icon--wet {
    border-color: rgb(80, 150, 255);
}

.cf-status-icon--damageovertime {
    border-color: rgb(255, 120, 60);
}

.cf-status-icon--healingbudget {
    border-color: rgb(110, 220, 130);
}

.cf-status-icon--hardcontrol {
    border-color: rgb(255, 220, 80);
}

.cf-duel-bars {
    position: absolute;
    left: 24px;
    bottom: 24px;
    width: 520px;
    background-color: rgba(10, 12, 18, 0.6);
    padding: 10px 12px;
    border-radius: 6px;
}

.cf-bar-row {
    margin-bottom: 6px;
}

.cf-bar-label {
    font-size: 15px;
    color: rgb(232, 228, 216);
    margin-bottom: 2px;
}

.cf-bar-track {
    height: 18px;
    background-color: rgba(30, 32, 40, 0.95);
    border-color: rgb(70, 74, 90);
    border-width: 1px;
    border-radius: 3px;
    overflow: hidden;
}

.cf-bar-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
}

.cf-bar-fill--health {
    background-color: rgb(210, 70, 70);
}

.cf-bar-fill--shield {
    background-color: rgb(220, 230, 255);
}

.cf-bar-fill--mana {
    background-color: rgb(70, 120, 230);
}

.cf-bar-fill--stamina {
    background-color: rgb(220, 190, 70);
}

.cf-duel-spells {
    position: absolute;
    left: 28%;
    right: 28%;
    bottom: 24px;
    align-items: center;
}

.cf-duel-selected {
    font-size: 18px;
    color: rgb(244, 236, 214);
    background-color: rgba(10, 12, 18, 0.7);
    padding: 3px 12px;
    border-radius: 4px;
    margin-bottom: 6px;
}

.cf-slot-row {
    flex-direction: row;
}

.cf-slot {
    width: 118px;
    min-height: 86px;
    margin: 0 3px;
    padding: 4px 6px;
    background-color: rgba(20, 24, 34, 0.85);
    border-width: 2px;
    border-color: rgb(80, 88, 110);
    border-radius: 5px;
}

.cf-slot--selected {
    border-color: rgb(244, 214, 140);
    background-color: rgba(70, 60, 30, 0.9);
}

.cf-slot--unavailable .cf-slot-name {
    color: rgb(140, 144, 156);
}

.cf-slot-number {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(244, 214, 140);
}

.cf-slot-name {
    font-size: 13px;
    color: rgb(232, 228, 216);
    white-space: normal;
}

.cf-slot-state {
    font-size: 12px;
    color: rgb(170, 176, 190);
}

.cf-duel-actions {
    position: absolute;
    right: 24px;
    bottom: 24px;
    width: 420px;
}

.cf-action {
    flex-direction: row;
    align-items: center;
    background-color: rgba(20, 24, 34, 0.85);
    border-width: 2px;
    border-color: rgb(110, 120, 150);
    border-radius: 5px;
    padding: 4px 8px;
    margin-top: 6px;
}

.cf-action--unavailable {
    border-color: rgb(70, 74, 90);
    opacity: 0.75;
}

.cf-action-key {
    width: 34px;
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(244, 214, 140);
}

.cf-action-text {
    flex-shrink: 1;
}

.cf-action-name {
    font-size: 15px;
    color: rgb(232, 228, 216);
    white-space: normal;
}

.cf-action-detail {
    font-size: 12px;
    color: rgb(170, 176, 190);
}

.cf-duel-combat {
    margin-top: 6px;
    background-color: rgba(10, 12, 18, 0.65);
    padding: 2px 8px;
    border-radius: 3px;
    align-self: flex-start;
    font-size: 15px;
    color: rgb(232, 228, 216);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
    white-space: normal;
}

.cf-damage-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.cf-damage-number {
    position: absolute;
    width: 240px;
    font-size: 38px;
    -unity-font-style: bold;
    color: rgb(255, 236, 160);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(30, 10, 0);
}

.cf-damage-number--guarded {
    color: rgb(170, 210, 255);
    font-size: 24px;
}

.cf-damage-number--lethal {
    color: rgb(255, 110, 90);
    font-size: 38px;
}
